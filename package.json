{
  "name": "opencode-qimage",
  "version": "0.1.0",
  "description": "OpenCode plugin: image_gen / image_edit tools routed by provider/model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
